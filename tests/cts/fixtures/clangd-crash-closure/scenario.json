{
  "name": "clangd-crash-closure",
  "description": "0.0.17 W5 (#59 U7a) under the crash ledger's rule (issue 86, design 2026-11-12 S3), Linux and macOS: the stand-in clangd (`prepare clangd-crash-closure`) crashes 25 seconds in with a crash context naming src/main.cpp, which the editor is typing in: main.cpp is set aside, as a file clangd crashed on is. Then another importer of hello.greet is edited and the module's partition changes, so clangd builds the modules main.cpp imports again. From 0.0.17 to 0.22.0 that sent main.cpp back at once -- and so did a restart, which builds the same modules again, each return an engine start (issue 86: five returns of one file in a session, an exit after each). Now a rebuilt closure makes the file eligible and it goes back when its term is over: it is still aside right after the rebuild (R2), and back with clangd once the two minutes from the crash have passed (R3), where it builds and nothing is held against it any more.",
  "prepare": [
    [
      "{conformance}",
      "prepare",
      "clangd-crash-closure",
      "{payload}"
    ]
  ],
  "server-arguments": [
    "--clangd",
    "{workspace}/stand-in/clangd",
    "--no-discover"
  ],
  "checks": [
    {
      "id": "S1",
      "kind": "status",
      "state": "ready",
      "engine-name": "clangd"
    },
    {
      "id": "W1-warmed-up",
      "kind": "hover-contains",
      "file": "src/main.cpp",
      "at": [
        4,
        31
      ],
      "expect": "greet",
      "timeout": 90
    },
    {
      "id": "T1-editing-when-it-crashes",
      "kind": "type-text",
      "file": "src/main.cpp",
      "line": 2,
      "steps": [
        "i",
        "in",
        "int",
        "int x",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        "int x;",
        ""
      ],
      "interval-ms": 500,
      "answer-within": 15
    },
    {
      "id": "R1-the-file-it-named",
      "kind": "report",
      "timeout": 30,
      "expect": [
        {
          "path": "/roots/0/engines/*/details/lastExit/crashFile",
          "contains": "main.cpp"
        },
        {
          "path": "/roots/0/engines/*/details/filesSetAside",
          "min-items": 1
        },
        {
          "path": "/roots/0/engines/*/details/filesSetAside/*",
          "each-contains": "main.cpp"
        }
      ]
    },
    {
      "id": "W2-another-importer",
      "kind": "hover-contains",
      "file": "src/crasher.cpp",
      "at": [
        3,
        4
      ],
      "expect": "crash_here",
      "timeout": 90
    },
    {
      "id": "E1-its-module-changes",
      "kind": "write-file",
      "file": "src/greet/detail.cppm",
      "text": "export module hello.greet:detail;\nimport std;\nexport namespace hello::detail {\n  std::string prefix() { return \"Hi, \"; }\n}\n"
    },
    {
      "id": "E2-the-importer-is-rebuilt",
      "kind": "type-text",
      "file": "src/crasher.cpp",
      "line": 2,
      "steps": [
        "int y;",
        "int y;",
        ""
      ],
      "interval-ms": 1000,
      "answer-within": 60
    },
    {
      "id": "R2-eligible-not-yet-back",
      "kind": "report",
      "timeout": 10,
      "expect": [
        {
          "path": "/roots/0/engines/*/details/filesSetAside",
          "min-items": 1
        },
        {
          "path": "/roots/0/engines/*/details/crashLedger/*/exits",
          "equals": 1
        }
      ]
    },
    {
      "id": "R3-handed-back-when-its-term-is-over",
      "kind": "report",
      "timeout": 170,
      "expect": [
        {
          "path": "/roots/0/events/*/kind",
          "equals": "file-handed-back"
        },
        {
          "path": "/roots/0/engines/*/details/filesSetAside",
          "max-items": 0
        }
      ]
    },
    {
      "id": "T3-clangd-answers-for-it-again",
      "kind": "hover-contains",
      "file": "src/main.cpp",
      "at": [
        4,
        31
      ],
      "expect": "greet",
      "timeout": 60
    },
    {
      "id": "R4-nothing-held-against-it",
      "kind": "report",
      "timeout": 30,
      "expect": [
        {
          "path": "/roots/0/events/*/kind",
          "equals": "crash-ledger-cleared"
        },
        {
          "path": "/roots/0/engines/*/details/filesSetAside",
          "max-items": 0
        }
      ]
    }
  ]
}
