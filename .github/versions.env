# The versions CI builds with. One file, so a bump cannot land in one workflow and miss another.
# `.github/actions/setup-mcpp` exports these, and only where a workflow has not set them already
# (nightly overrides MCPP_VERSION to `latest` to meet the next mcpp before it is pinned).
#
# These are build inputs, not the product's version: that one lives in mcpp.toml and is checked
# everywhere else by `mcppls-devtools version --check`.
MCPP_VERSION=2026.9.21.3
LLVM_VERSION=22.1.8
XLINGS_VERSION=v2026.8.17.2
