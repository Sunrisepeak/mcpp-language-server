# The versions CI builds with. One file, so a bump cannot land in one workflow and miss another.
# `.github/actions/setup-mcpp` exports these, and only where a workflow has not set them already
# (nightly overrides MCPP_VERSION to `latest` to meet the next mcpp before it is pinned).
#
# These are build inputs, not the product's version: that one lives in mcpp.toml and is checked
# everywhere else by `mcppls-devtools version --check`.
# 2026.10.26.2: the first mcpp that builds the ok images (`<arch>-openkal`, okld, okrun, pack --mode
# self-contained) the payloads' servers carry, and writes the build record mcppls reads (#71).
MCPP_VERSION=2026.10.26.2
# The mcpp a fixture that declares "requires-mcpp" runs with (MCPPLS_REAL_MCPP), installed beside MCPP_VERSION, which
# stays the default: the first whose build database describes build programs (build.mcpp, mcpp-community/mcpp#797),
# and later than the one that quotes a Windows argument ending in a backslash (2026.10.5.2, mcpp-target-windows-real).
MCPP_FIXTURE_VERSION=2026.10.11.1
LLVM_VERSION=22.1.8
XLINGS_VERSION=v2026.8.17.2
# The xmake the xmake conformance fixtures run (installed from xlings; 0.0.8 part 2 X-7).
XMAKE_VERSION=3.1.1
VSCODIUM_VERSION=1.135.06055
# The Zed the real-editor smoke test runs (editors/zed/tests/smoke.sh): a stable release, Linux x86-64.
# Checked against the tarball's sha256 before it is unpacked.
ZED_VERSION=1.22.0
ZED_LINUX_X86_64_SHA256=5ce3991b34a8fad0a23625f5821cda601c7150a6cc69683c097b8d1b083abc50
