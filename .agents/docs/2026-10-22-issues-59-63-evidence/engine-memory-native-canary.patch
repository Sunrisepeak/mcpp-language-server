+// Run this lifecycle canary in an isolated process: Store is a process singleton.
+// Poll uses the real periodic write path, after flush has joined its worker.
+TEST_F(PrerequisiteModulesTests, UnchangedMemosDoNotConstructJSON) {
+  writeTestFile(TestDir, "quiet-input.cpp", "int before;\n");
+  writeTestFile(TestDir, "quiet.pcm", "identity-only test payload");
+  const auto Input = getFullPath("quiet-input.cpp");
+  const auto BMI = getFullPath("quiet.pcm");
+  const auto File = getFullPath("quiet-memos/module-memos.json");
+  auto Identity = ModuleValidationCache::identityOf(Input);
+  ASSERT_TRUE(Identity);
+  getModuleValidationCache().markFresh(BMI, "quiet-canary", {{Input, *Identity}});
+  const auto Before = moduleMemosJSONBuildCountForTest();
+  startModuleMemoStore(getFullPath("quiet-memos"));
+  flushModuleMemoStore();
+  const auto First = moduleMemosJSONBuildCountForTest();
+  EXPECT_EQ(First, Before + 1);
+  std::string InitialBytes;
+  {
+    auto InitialFile = llvm::MemoryBuffer::getFile(File);
+    ASSERT_TRUE(InitialFile);
+    InitialBytes = (*InitialFile)->getBuffer().str();
+  } // close the mapping before a later rename, including on Windows
+  for (unsigned I = 0; I != 10; ++I)
+    ASSERT_TRUE(pollModuleMemoStoreForTest());
+  EXPECT_EQ(moduleMemosJSONBuildCountForTest(), First);
+  {
+    auto QuietFile = llvm::MemoryBuffer::getFile(File);
+    ASSERT_TRUE(QuietFile);
+    EXPECT_EQ((*QuietFile)->getBuffer(), InitialBytes);
+  }
+  // Dirty data still builds JSON and reaches disk on the same periodic path.
+  writeTestFile(TestDir, "quiet-input.cpp", "int after_changed;\n");
+  Identity = ModuleValidationCache::identityOf(Input);
+  ASSERT_TRUE(Identity);
+  getModuleValidationCache().markFresh(BMI, "quiet-canary", {{Input, *Identity}});
+  ASSERT_TRUE(pollModuleMemoStoreForTest());
+  EXPECT_EQ(moduleMemosJSONBuildCountForTest(), First + 1);
+  auto ChangedFile = llvm::MemoryBuffer::getFile(File);
+  ASSERT_TRUE(ChangedFile);
+  EXPECT_NE((*ChangedFile)->getBuffer(), InitialBytes);
+  // Final flush deliberately keeps the pre-fix snapshot behavior.
+  flushModuleMemoStore();
+  EXPECT_EQ(moduleMemosJSONBuildCountForTest(), First + 2);
+}
+
 TEST_F(PrerequisiteModulesTests, MemosKeptForTheNextSession) {
