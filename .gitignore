target/
node_modules/
editors/vscode/out/
editors/vscode/payload/
*.vsix
__pycache__/
compile_commands.json
.cache/
editors/zed/target/
editors/zed/extension.wasm
editors/clion/build/
editors/clion/.gradle/
.payload-cache/

# mcpp writes the declared environment here, derived from [xlings] in mcpp.toml.
.mcpp/

# Gradle and IntelliJ platform build state for the CLion plugin.
editors/clion/.gradle/
editors/clion/.kotlin/
editors/clion/.intellijPlatform/

# Scratch space for tests that must write where the program is preopened.
.test-scratch/

# mcpp writes these on every build; they record what was resolved and do not pin later builds
# (the file's own header says so), so a committed copy only goes stale. Revisit when mcpp.lock pins.
mcpp.lock

# The generated-module fixtures (real-project plan RP0) check in a file at the path a package's own
# build.mcpp would generate it at, so each is self-contained; `target/` above would otherwise hide
# it. Only those fixtures: any other fixture's target/ is build output like everywhere else.
!conformance/fixtures/generated-module*/target/
