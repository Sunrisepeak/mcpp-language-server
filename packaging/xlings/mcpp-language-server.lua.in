-- mcpp-language-server: the compiler-agnostic C++ modules language server, program mcppls (xim-pkgindex entry).
--
-- Rendered by `mcppls-devtools release xlings` for one release; the rendered file goes to
-- xim-pkgindex as pkgs/m/mcpp-language-server.lua. One asset for every system: the release's
-- openkal tree (mcppls-<version>-openkal.zip), the server's images of both architectures with the
-- runner of each system it runs on by itself; each system block names the architectures its
-- mcpp-package.json `runs_on.self` covers. The server finds clangd on PATH (llvm-tools) and reads
-- code without a compiler with the openkal kit (mcppls-kit-openkal); the kit of a project's target
-- (mcppls-kit-<target>) is installed when the editor asks for it.
package = {
    spec = "2",

    name = "mcpp-language-server",
    description = "Compiler-agnostic C++ modules language server: module navigation, completion and diagnostics for any compiler, with clangd",

    authors = {"Sunrisepeak"},
    licenses = {"Apache-2.0"},
    repo = "https://github.com/Sunrisepeak/mcpp-language-server",

    type = "package",
    archs = {@ARCHS@},
    status = "dev",
    categories = {"lsp", "cpp"},
    keywords = {"c++", "modules", "lsp", "clangd", "mcpp"},

    programs = { "mcppls" },
    xvm_enable = true,

    xpm = {
        deps = { "xim:llvm-tools@@CLANGD_VERSION@", "xim:mcppls-kit-openkal@@OPENKAL_KIT_VERSION@" },
@XPM_SYSTEMS@    },
}

import("xim.libxpkg.pkginfo")
import("xim.libxpkg.xvm")

function install()
    -- The archive holds mcppls-<version>-openkal/: bin/mcppls (POSIX launcher), bin/mcppls.exe (Windows
    -- launcher), lib/<arch>/mcppls.oke and libexec/okrun/<system>-<arch>/.
    local root = pkginfo.install_file():replace(".zip", "")
    os.tryrm(pkginfo.install_dir())
    os.trymv(root, pkginfo.install_dir())
    return true
end

function config()
    local opts = { bindir = path.join(pkginfo.install_dir(), "bin") }
    if os.host() == "windows" then opts.alias = "mcppls.exe" end
    xvm.add("mcppls", opts)
    return true
end

function uninstall()
    xvm.remove("mcppls")
    return true
end
