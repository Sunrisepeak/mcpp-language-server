-- mcppls-kit-@KIT_NAME@: the semantic kit (spec S4) mcppls reads @KIT_TARGET@ code with where there is
-- no compiler: @KIT_WHAT@. Data only; no programs (S4-4-1).
--
-- Rendered by `mcppls-devtools release xlings`, once per kit of the release (packaging/payload.lock.json's
-- platforms, and the openkal kit); goes to xim-pkgindex as pkgs/m/mcppls-kit-@KIT_NAME@.lua. A kit is data,
-- so one asset serves every system: a project on one system may read for another system's target.
package = {
    spec = "2",

    name = "mcppls-kit-@KIT_NAME@",
    description = "Standard library headers and std module sources for mcppls without a compiler (S4 semantic kit, @KIT_TARGET@)",

    authors = {"Sunrisepeak"},
    licenses = {@KIT_LICENSES@},
    repo = "https://github.com/Sunrisepeak/mcpp-language-server",

    type = "package",
    archs = {"x86_64", "aarch64"},
    status = "dev",
    categories = {"cpp", "data"},
    keywords = {"libc++", "std module", "kit", "mcppls"},

    xpm = {
        linux = {
            ["latest"] = { ref = "@KIT_VERSION@" },
            ["@KIT_VERSION@"] = { url = "@KIT_URL@", sha256 = { x86_64 = "@KIT_SHA256@", aarch64 = "@KIT_SHA256@" } },
        },
        macosx = {
            ["latest"] = { ref = "@KIT_VERSION@" },
            ["@KIT_VERSION@"] = { url = "@KIT_URL@", sha256 = { x86_64 = "@KIT_SHA256@", aarch64 = "@KIT_SHA256@" } },
        },
        windows = {
            ["latest"] = { ref = "@KIT_VERSION@" },
            ["@KIT_VERSION@"] = { url = "@KIT_URL@", sha256 = { x86_64 = "@KIT_SHA256@", aarch64 = "@KIT_SHA256@" } },
        },
    },
}

import("xim.libxpkg.pkginfo")

function install()
    -- The archive holds mcppls-kit-@KIT_NAME@-@KIT_VERSION@/kit.json and the kit beside it; mcppls looks for
    -- kit.json directly in this package's install directory.
    local root = pkginfo.install_file():replace(".tar.gz", "")
    os.tryrm(pkginfo.install_dir())
    os.trymv(root, pkginfo.install_dir())
    return true
end
