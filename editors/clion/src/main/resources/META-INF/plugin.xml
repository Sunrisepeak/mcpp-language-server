<idea-plugin>
    <id>io.github.sunrisepeak.mcppls</id>
    <name>C++ Modules Language Server</name>
    <vendor url="https://github.com/Sunrisepeak/mcpp-language-server">Sunrisepeak</vendor>

    <description><![CDATA[
        mcppls - C++20 named modules that work on any compiler. mcpp-language-server normalizes how the
        project is built — mcpp, CMake, a compile_commands.json, or nothing — into one module
        description, drives its own pinned clangd with it, and answers module-level requests.
        <br/><br/>
        The server must be on PATH: download payload-&lt;platform&gt;.tar.gz from the
        <a href="https://github.com/Sunrisepeak/mcpp-language-server/releases">release page</a>,
        unpack it and put its payload/bin directory on PATH.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- CLion's C/C++ engine, for telling whether it models the project (ClionModel). Optional: without it
         the probe is absent and the CMakeLists.txt check alone decides. -->
    <depends optional="true" config-file="mcppls-cidr.xml">com.intellij.clion</depends>

    <extensionPoints>
        <extensionPoint name="workspaceProbe" interface="community.mcpp.mcppls.ClionWorkspaceProbe" dynamic="true"/>
    </extensionPoints>

    <extensions defaultExtensionNs="com.intellij">
        <platform.lsp.serverSupportProvider
            implementation="community.mcpp.mcppls.McpplsServerSupportProvider"/>
        <applicationService serviceImplementation="community.mcpp.mcppls.McpplsSettings"/>
        <applicationConfigurable parentId="tools" instance="community.mcpp.mcppls.McpplsConfigurable"
                                 id="community.mcpp.mcppls.settings" displayName="mcppls"/>
        <notificationGroup id="mcppls" displayType="BALLOON"/>
    </extensions>
</idea-plugin>
