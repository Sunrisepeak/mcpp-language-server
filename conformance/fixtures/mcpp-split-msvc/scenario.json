{
  "name": "mcpp-split-msvc",
  "description": "mcpp-split built by the machine's Visual Studio (msvc@system): the same interface/implementation split, cl.exe arguments translated, the MSVC STL std module injected.",
  "checks": [
    {
      "id": "S1",
      "kind": "status",
      "source": "mcpp",
      "profile-kind": "build-toolchain",
      "level": 3,
      "state": "ready",
      "profile-compiler": "msvc"
    },
    {
      "id": "C1",
      "kind": "diagnostics-empty",
      "file": "src/main.cpp"
    },
    {
      "id": "C1-implementation",
      "kind": "diagnostics-empty",
      "file": "src/greet/greet.cpp"
    },
    {
      "id": "C1-second-implementation",
      "kind": "diagnostics-empty",
      "file": "src/greet/format.cpp"
    },
    {
      "id": "C1-implementation-partition",
      "kind": "diagnostics-empty",
      "file": "src/greet/counter.cppm"
    },
    {
      "id": "C2-declaration",
      "kind": "declaration",
      "file": "src/main.cpp",
      "at": [
        4,
        31
      ],
      "expect": "src/greet/greet.cppm"
    },
    {
      "id": "C2-definition",
      "kind": "definition",
      "file": "src/main.cpp",
      "at": [
        4,
        31
      ],
      "expect": "src/greet/greet.cpp"
    },
    {
      "id": "C2-definition-count",
      "kind": "definition",
      "file": "src/main.cpp",
      "at": [
        5,
        19
      ],
      "expect": "src/greet/greet.cpp"
    },
    {
      "id": "C3",
      "kind": "hover-contains",
      "file": "src/main.cpp",
      "at": [
        4,
        31
      ],
      "expect": "greet"
    },
    {
      "id": "C4",
      "kind": "definition-any",
      "file": "src/main.cpp",
      "at": [
        4,
        11
      ]
    },
    {
      "id": "C5",
      "kind": "definition",
      "file": "src/main.cpp",
      "at": [
        1,
        9
      ],
      "expect": "src/greet/greet.cppm"
    },
    {
      "id": "C5-partition",
      "kind": "definition",
      "file": "src/greet/greet.cppm",
      "at": [
        3,
        16
      ],
      "expect": "src/greet/format.cppm"
    },
    {
      "id": "C8-implementation-to-partition-declaration",
      "kind": "declaration",
      "file": "src/greet/greet.cpp",
      "at": [
        8,
        12
      ],
      "expect": "src/greet/format.cppm"
    },
    {
      "id": "C8-implementation-to-definition",
      "kind": "definition",
      "file": "src/greet/greet.cpp",
      "at": [
        8,
        12
      ],
      "expect": "src/greet/format.cpp"
    },
    {
      "id": "C8-implementation-partition",
      "kind": "definition",
      "file": "src/greet/greet.cpp",
      "at": [
        7,
        13
      ],
      "expect": "src/greet/counter.cppm"
    },
    {
      "id": "C8-implementation-hover",
      "kind": "hover-contains",
      "file": "src/greet/greet.cpp",
      "at": [
        12,
        20
      ],
      "expect": "value"
    },
    {
      "id": "C6",
      "kind": "completion-contains",
      "file": "src/main.cpp",
      "insert": [
        6,
        "    hello::"
      ],
      "at": [
        6,
        11
      ],
      "expect": "decorate"
    },
    {
      "id": "C6-implementation",
      "kind": "completion-contains",
      "file": "src/greet/greet.cpp",
      "insert": [
        13,
        "    detail::"
      ],
      "at": [
        13,
        12
      ],
      "expect": "bump"
    },
    {
      "id": "C7",
      "kind": "completion-contains",
      "file": "src/main.cpp",
      "at": [
        6,
        11
      ],
      "expect": "greet2",
      "edit": {
        "file": "src/greet/greet.cppm",
        "replace": "int count();",
        "with": "int count();\nint greet2();"
      }
    },
    {
      "id": "C9",
      "kind": "references-span",
      "file": "src/main.cpp",
      "at": [
        4,
        31
      ],
      "expect": [
        "src/main.cpp",
        "src/greet/greet.cppm",
        "src/greet/greet.cpp"
      ]
    },
    {
      "id": "C10-test",
      "kind": "definition",
      "file": "tests/greet_test.cpp",
      "at": [
        4,
        19
      ],
      "expect": "src/greet/greet.cpp"
    },
    {
      "id": "W1",
      "kind": "workspace-unchanged"
    }
  ]
}
