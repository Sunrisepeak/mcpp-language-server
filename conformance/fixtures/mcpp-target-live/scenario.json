{
  "name": "mcpp-target-live",
  "description": "Startup auto follows i686. Standard didChangeConfiguration updates switch to explicit x64, project defaults and back to auto on the same running server.",
  "prepare": [
    [
      "{runner-dir}/mcppls-mock-mcpp{exe}",
      "--write-target-cdb",
      "i686-unknown-linux-gnu"
    ]
  ],
  "server-arguments": [
    "--mcpp",
    "{runner-dir}/mcppls-mock-mcpp{exe}"
  ],
  "checks": [
    {
      "id": "S1-initial-auto",
      "kind": "status",
      "source": "mcpp",
      "state": "ready",
      "profile-target": "i686-unknown-linux-gnu",
      "target-mode": "auto",
      "target-requested": "i686-unknown-linux-gnu",
      "target-source": "compile-commands",
      "target-pending": false,
      "timeout": 60
    },
    {
      "id": "C1-fix-x64",
      "kind": "configuration",
      "settings": {
        "mcppls": {
          "buildDiscovery.mcppTarget": "x86_64-unknown-linux-gnu"
        }
      }
    },
    {
      "id": "S2-live-explicit",
      "kind": "status",
      "source": "mcpp",
      "state": "ready",
      "profile-target": "x86_64-unknown-linux-gnu",
      "target-mode": "explicit",
      "target-requested": "x86_64-unknown-linux-gnu",
      "target-source": "configuration",
      "target-pending": false,
      "timeout": 60
    },
    {
      "id": "C2-project-defaults",
      "kind": "configuration",
      "settings": {
        "mcppls": {
          "buildDiscovery.mcppTarget": "project"
        }
      }
    },
    {
      "id": "S3-live-project",
      "kind": "status",
      "source": "mcpp",
      "state": "ready",
      "profile-target": "x86_64-unknown-linux-gnu",
      "target-mode": "project",
      "target-requested": "",
      "target-source": "project",
      "target-pending": false,
      "timeout": 60
    },
    {
      "id": "C3-auto-again",
      "kind": "configuration",
      "settings": {
        "mcppls": {
          "buildDiscovery.mcppTarget": "auto"
        }
      }
    },
    {
      "id": "S4-live-auto",
      "kind": "status",
      "source": "mcpp",
      "state": "ready",
      "profile-target": "i686-unknown-linux-gnu",
      "target-mode": "auto",
      "target-requested": "i686-unknown-linux-gnu",
      "target-source": "compile-commands",
      "target-pending": false,
      "timeout": 60
    },
    {
      "id": "A1-four-target-decisions",
      "kind": "producer-call-log",
      "file": "mcpp-calls.jsonl",
      "command": "emit",
      "count": 4,
      "arguments-contains": [
        "--target",
        "i686-unknown-linux-gnu"
      ]
    }
  ]
}
