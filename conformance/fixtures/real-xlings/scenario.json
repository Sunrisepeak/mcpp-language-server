{
  "name": "real-xlings",
  "description": "Real-project plan RP0: the xlings repository at a fixed commit, about 110 modules with a dependency (libxpkg) that generates a module at build time. Its committed .xlings.json sets projectScope false, so the mcpp on PATH describes it. Nightly and pre-release.",
  "prepare": [
    [
      "git",
      "init",
      "-q"
    ],
    [
      "git",
      "fetch",
      "-q",
      "--depth",
      "1",
      "https://github.com/openxlings/xlings.git",
      "84572b0cc8502a16afaa4ae00867aef17f18c2c2"
    ],
    [
      "git",
      "checkout",
      "-q",
      "FETCH_HEAD"
    ],
    [
      "mcpp",
      "emit",
      "build-database"
    ]
  ],
  "checks": [
    {
      "id": "S1",
      "kind": "status",
      "source": "mcpp",
      "tier": 1,
      "timeout": 120
    },
    {
      "id": "M1-import-cli",
      "kind": "definition",
      "file": "src/main.cpp",
      "at": [
        2,
        7
      ],
      "expect": "src/cli.cppm"
    },
    {
      "id": "C1-platform-call",
      "kind": "definition-any",
      "file": "src/main.cpp",
      "at": [
        33,
        22
      ]
    },
    {
      "id": "C2-hover",
      "kind": "hover-contains",
      "file": "src/main.cpp",
      "at": [
        33,
        22
      ],
      "expect": "init_console_output"
    },
    {
      "id": "STRESS1",
      "kind": "stress",
      "seed": 13,
      "actions": 60,
      "requestTimeout": 65,
      "files": [
        "src/**/*.cppm",
        "src/**/*.cpp"
      ],
      "budget": {
        "timeouts": 0,
        "p90": 3,
        "maxStallSeconds": 60
      }
    }
  ]
}
