{
  "name": "module-faults",
  "description": "Faults stay where they are (robustness design C2-C6): a module chain with an import nothing provides, a module that does not compile, and a file importing both a broken chain and a working module. Files unrelated to a fault keep every feature, a file importing a broken module keeps what does resolve, nothing waits, and a module that breaks and heals while the server runs neither stalls clangd nor leaves the project without it.",
  "server-arguments": ["--no-discover"],
  "checks": [
    { "id": "S1", "kind": "status", "source": "inferred", "state": "degraded", "issue-code": "unresolved-module", "issue-message": "nowhere", "engine-name": "clangd" },
    { "id": "F0-stand-in", "kind": "report", "expect": [{ "path": "/roots/0/plan/standIns", "contains": "nowhere" }, { "path": "/roots/0/plan/leftOutCount", "equals": 0 }] },
    { "id": "F1-working-module", "kind": "hover-contains", "file": "src/good/user.cppm", "at": [3, 28], "expect": "answer", "timeout": 90 },
    { "id": "F1-definition", "kind": "definition", "file": "src/good/user.cppm", "at": [3, 28], "expect": "src/good/a.cppm", "timeout": 60 },
    { "id": "F2-importer-of-a-broken-chain", "kind": "hover-contains", "file": "src/main.cpp", "at": [4, 12], "expect": "twice", "timeout": 90 },
    { "id": "F3-plain-file", "kind": "hover-contains", "file": "src/plain.cpp", "at": [2, 19], "expect": "square", "timeout": 30 },
    { "id": "F4-importer-of-a-module-that-does-not-compile", "kind": "responds", "file": "src/broken/f.cppm", "at": [3, 25], "method": "textDocument/hover", "timeout": 20 },
    { "id": "F4b-plain-importer-of-a-doomed-closure-responds", "kind": "responds", "file": "src/plain-importer.cpp", "at": [5, 26], "method": "textDocument/hover", "timeout": 15 },
    { "id": "F4c-plain-importer-names-the-failed-module", "kind": "diagnostic-code", "file": "src/plain-importer.cpp", "expect": "module-failed", "timeout": 30 },
    { "id": "F5-importer-of-a-module-with-a-missing-import", "kind": "hover-contains", "file": "src/bad/c.cppm", "at": [3, 25], "expect": "fb", "timeout": 60 },
    { "id": "F6-module-breaks", "kind": "write-file", "file": "src/good/a.cppm", "content-from": "src/good/a-broken.txt" },
    { "id": "F6-plain-file-still-answered", "kind": "hover-contains", "file": "src/plain.cpp", "at": [0, 4], "expect": "square", "timeout": 60 },
    { "id": "F6-importer-responds", "kind": "responds", "file": "src/main.cpp", "at": [4, 12], "method": "textDocument/hover", "timeout": 30 },
    { "id": "F6-importer-keeps-its-features-or-says-why", "kind": "hover-contains", "file": "src/main.cpp", "at": [4, 12],
      "expect": ["twice", "still being built", "still preparing modules"], "timeout": 60 },
    { "id": "F7-module-heals", "kind": "write-file", "file": "src/good/a.cppm", "content-from": "src/good/a-restored.txt" },
    { "id": "F7-working-again", "kind": "hover-contains", "file": "src/good/user.cppm", "at": [3, 28], "expect": "answer", "timeout": 120 },
    { "id": "F8-no-restart-nothing-set-aside", "kind": "report", "timeout": 10,
      "expect": [{ "path": "/roots/0/engines/*/details/restarts", "max-items": 0 }, { "path": "/roots/0/engines/*/details/filesSetAside", "max-items": 0 },
                 { "path": "/roots/0/eventTotals/plan", "exists": true }, { "path": "/server/version", "exists": true }] },
    { "id": "STRESS1", "kind": "stress", "seed": 7, "actions": 40, "requestTimeout": 15,
      "files": ["src/**/*.cppm", "src/**/*.cpp"],
      "budget": { "timeouts": 0, "p90": 5, "maxStallSeconds": 45, "cpuSecondsPerMinute": 600, "rssMB": 3000 } }
  ]
}
