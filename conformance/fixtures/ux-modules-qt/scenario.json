{
  "name": "ux-modules-qt",
  "description": "C++ modules mixed with Qt headers (0.0.12, issue #50): a module unit whose global module fragment includes <QtWidgets/QtWidgets>, another that includes Qt Core headers, and a file that includes Qt headers and imports both, built by CMake with clang++ against the system's Qt 5 (qtbase5-dev). Answers are right, and they stay fast while a person types in the importer and in a module unit that autosaves: every completion answered, no restart (a crash counts as one), nothing set aside, diagnostics back within seconds.",
  "server-arguments": [
    "--no-discover"
  ],
  "prepare": [
    [
      "cmake",
      "-S",
      ".",
      "-B",
      "build",
      "-G",
      "Ninja",
      "-DCMAKE_CXX_COMPILER={env:CONFORMANCE_CLANGXX|clang++}",
      "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
    ],
    [
      "cmake",
      "--build",
      "build"
    ]
  ],
  "checks": [
    {
      "id": "S1",
      "kind": "status",
      "source": "cmake",
      "state": "ready",
      "engine-name": "clangd"
    },
    {
      "id": "C1",
      "kind": "diagnostics-empty",
      "file": "src/main.cpp",
      "timeout": 240
    },
    {
      "id": "C1-module-with-qt-widgets",
      "kind": "diagnostics-empty",
      "file": "src/view.cppm",
      "timeout": 240
    },
    {
      "id": "C2-hover-module-member",
      "kind": "hover-contains",
      "file": "src/main.cpp",
      "at": [
        8,
        16
      ],
      "expect": "addItem",
      "timeout": 120
    },
    {
      "id": "C3-definition-into-module",
      "kind": "definition",
      "file": "src/main.cpp",
      "at": [
        8,
        16
      ],
      "expect": "src/model.cppm",
      "timeout": 60
    },
    {
      "id": "C4-qt-member-through-module",
      "kind": "hover-contains",
      "file": "src/main.cpp",
      "at": [
        10,
        32
      ],
      "expect": "rowCount",
      "timeout": 60
    },
    {
      "id": "U3-idle",
      "kind": "latency",
      "phase": "idle",
      "rounds": 20,
      "requests": [
        {
          "kind": "completion",
          "name": "module-member",
          "file": "src/main.cpp",
          "at": [
            10,
            31
          ]
        },
        {
          "kind": "completion",
          "name": "qt-member",
          "file": "src/main.cpp",
          "at": [
            10,
            11
          ]
        },
        {
          "kind": "hover",
          "file": "src/main.cpp",
          "at": [
            8,
            16
          ]
        },
        {
          "kind": "definition",
          "file": "src/main.cpp",
          "at": [
            8,
            16
          ],
          "expect": "src/model.cppm"
        }
      ],
      "budget": {
        "completion.p95": 0.5,
        "hover.p95": 0.3,
        "definition.p95": 0.5,
        "engineShare": 0.9
      }
    },
    {
      "id": "U5-typing-in-the-importer",
      "kind": "typing",
      "file": "src/main.cpp",
      "seconds": 60,
      "hz": 10,
      "completion-every-ms": 1000,
      "scripts": [
        {
          "line": 12,
          "text": "inventory.addItem(QStringLiteral(\"nut\")); window.showCount(inventory.rowC"
        },
        {
          "line": 12,
          "text": "auto names = inventory.itemNames(); names.sort(); window.setWindowTitle(names.join(QStringLiteral(\", \")));"
        },
        {
          "line": 12,
          "text": "QTimer timer; timer.setInterval(100); QObject::connect(&timer, &QTimer::timeout, &app, [&] { window.showCount(inventory.rowCount()); });"
        },
        {
          "line": 12,
          "text": "for (const auto& name : inventory.itemNames()) { window.statusBar()->showMessage(name); }"
        }
      ],
      "diagnostic-probe": {
        "line": 12,
        "text": "int ux_probe_typo = ux_undeclared_name;",
        "expect": "ux_undeclared_name"
      },
      "budget": {
        "firstOpenSeconds": 120,
        "p95": 1.0,
        "max": 3.0,
        "timeouts": 0,
        "restarts": 0,
        "filesSetAside": 0,
        "engineShare": 0.75,
        "diagnosticsRefresh": 6.0
      }
    },
    {
      "id": "U16-module-autosave",
      "kind": "typing",
      "file": "src/model.cppm",
      "seconds": 60,
      "hz": 10,
      "completion-every-ms": 1000,
      "autosave-idle-ms": 1000,
      "scripts": [
        {
          "line": 22,
          "text": "int countMatching(const QString& prefix) const { int total = 0; for (const auto& item : items_) { if (item.startsWith(prefix)) ++tot"
        },
        {
          "line": 22,
          "text": "QString firstItem() const { return items_.isEmpty() ? QString() : items_.fir"
        }
      ],
      "importer": {
        "file": "src/main.cpp",
        "line": 12,
        "text": "    inventory."
      },
      "budget": {
        "p95": 1.0,
        "max": 3.0,
        "timeouts": 0,
        "restarts": 0,
        "filesSetAside": 0,
        "importerP95": 1.5,
        "importerEmpty": 0,
        "moduleFailedDiagnostics": 0,
        "stalled": 0,
        "firstOpenSeconds": 120
      }
    },
    {
      "id": "STRESS1",
      "kind": "stress",
      "seed": 11,
      "actions": 60,
      "requestTimeout": 65,
      "files": [
        "src/*.cppm",
        "src/*.cpp"
      ],
      "budget": {
        "timeouts": 0,
        "p90": 5,
        "maxStallSeconds": 45,
        "rssMB": 3000
      }
    },
    {
      "id": "R1-no-crash-no-restart",
      "kind": "report",
      "timeout": 10,
      "expect": [
        {
          "path": "/roots/0/engines/*/details/restarts",
          "max-items": 0
        },
        {
          "path": "/roots/0/engines/*/details/filesSetAside",
          "max-items": 0
        }
      ]
    }
  ]
}
