          "equals": "hello.greet"
        },
        {
          "path": "/sets/0/role",
          "equals": "module-implementation"
        },
        {
          "path": "/projectSource",
          "equals": "mcpp"
        },
        {
          "path": "/semanticSource",
          "equals": "build-toolchain"
        },
        {
          "path": "/inModel",
          "equals": true
        }
      ]
    },
    {
      "id": "Q6-diagnostics",
      "kind": "mcp",
      "tool": "cxx_diagnostics",
