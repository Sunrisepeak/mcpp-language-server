{
  "name": "self-mcpp",
  "description": "The mcpp repository at a fixed commit (usable plan W8, E17): about 170 modules built with GCC 16. Its .xlings.json asks for mcpp 2026.9.21.1, which xlings runs inside it. The prepare step fetches its dependencies online once, as the server itself never does. Nightly.",
  "prepare": [
    [
      "git",
      "init",
      "-q"
    ],
    [
      "git",
      "fetch",
      "-q",
      "--depth",
      "1",
      "https://github.com/mcpp-community/mcpp",
      "d1f1c98fa26d953e084a183a9672fc1e0ce63558"
    ],
    [
      "git",
      "checkout",
      "-q",
      "FETCH_HEAD"
    ],
    [
      "mcpp",
      "emit",
      "build-database"
    ]
  ],
  "checks": [
    {
      "id": "S1",
      "kind": "status",
      "source": "mcpp",
      "state": "ready"
    },
    {
      "id": "C2-cli-run",
      "kind": "declaration",
      "file": "src/main.cpp",
      "at": [
        29,
        25
      ],
      "expect": "src/cli.cppm"
    },
    {
      "id": "C1-main",
      "kind": "diagnostics-empty",
      "file": "src/main.cpp"
    },
    {
      "id": "C2-ui",
      "kind": "declaration",
      "file": "src/main.cpp",
      "at": [
        25,
        16
      ],
      "expect": "src/ui.cppm"
    },
    {
      "id": "C3-cli-run",
      "kind": "hover-contains",
      "file": "src/main.cpp",
      "at": [
        29,
        25
      ],
      "expect": "run"
    },
    {
      "id": "C5-module",
      "kind": "definition",
      "file": "src/main.cpp",
      "at": [
        4,
        9
      ],
      "expect": "src/cli.cppm"
    },
    {
      "id": "M3-graph",
      "kind": "module-graph-contains",
      "expect": "mcpp.cli"
    }
  ]
}
