{
  "name": "typing-pause",
  "description": "Keys typed in a burst are diagnosed after their pause. Every live request keeps its parameters and deadline across same-version concurrency and later edits; only the client cancels a request.",
  "server-arguments": ["--no-discover"],
  "checks": [
    {"id": "S1", "kind": "status", "source": "inferred", "state": "ready", "engine-name": "clangd"},
    {"id": "C1", "kind": "diagnostics-empty", "file": "src/main.cpp"},
    {"id": "T0-request-lifetimes", "kind": "typing-requests", "file": "src/main.cpp"},
    {"id": "T1-burst", "kind": "typing-diagnostics", "file": "src/main.cpp", "line": 5, "character": 0, "type": "int a = missing_name;", "gap-ms": 120, "max-during": 0, "within-seconds": 5, "expect": "missing_name"},
    {"id": "C2-after", "kind": "definition", "file": "src/main.cpp", "at": [4, 31], "expect": "src/greet/greet.cppm"}
  ]
}
