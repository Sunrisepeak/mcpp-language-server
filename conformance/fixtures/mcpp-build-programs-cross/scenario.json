{
  "name": "mcpp-build-programs-cross",
  "description": "Build programs compiled with a toolchain of their own, as in a cross build, simulated by mcppls-mock-mcpp from what mcpp 2026.10.11.1 printed for mcpp-build-programs (mcpp-community/mcpp#797), with the build programs' sets given a second toolchain and mcpp's engine interface given stand-ins inside the fixture. The default context reads the targets and says where build.mcpp is read; the context app:build reads it with its own libraries; no formatting, code action or rename edits the engine interface.",
  "server-arguments": [
    "--mcpp",
    "{runner-dir}/mcppls-mock-mcpp{exe}"
  ],
  "checks": [
    {
      "id": "S1",
      "kind": "status",
      "source": "mcpp",
      "level": 3,
      "state": "ready"
    },
    {
      "id": "T1",
      "kind": "diagnostics-empty",
      "file": "src/main.cpp"
    },
    {
      "id": "K1",
      "kind": "diagnostic-code",
      "file": "build.mcpp",
      "expect": "build-program-context",
      "severity": 3,
      "line": 0,
      "$comment": "the default context reads the targets; build programs compiled with another toolchain are read in their own context"
    },
    {
      "id": "K2",
      "kind": "set-context",
      "file": "build.mcpp",
      "context": "app:build",
      "at": [
        7,
        44
      ],
      "expect": "both_value"
    },
    {
      "id": "K3",
      "kind": "definition",
      "file": "build.mcpp",
      "at": [
        6,
        19
      ],
      "expect": "deps/gen/src/gen.cppm"
    },
    {
      "id": "K4",
      "kind": "definition",
      "file": "build.mcpp",
      "at": [
        6,
        11
      ],
      "expect": "engine/modules/mcpp_core.cppm"
    },
    {
      "id": "E1",
      "kind": "request",
      "file": "engine/modules/mcpp_core.cppm",
      "method": "textDocument/formatting",
      "params": {
        "options": {
          "tabSize": 4,
          "insertSpaces": true
        }
      },
      "expect": [],
      "$comment": "mcpp's engine interface is read-only: no edit is offered there"
    },
    {
      "id": "E2",
      "kind": "request",
      "file": "engine/modules/mcpp_core.cppm",
      "method": "textDocument/codeAction",
      "params": {
        "range": {
          "start": {
            "line": 5,
            "character": 0
          },
          "end": {
            "line": 5,
            "character": 10
          }
        },
        "context": {
          "diagnostics": []
        }
      },
      "expect": []
    },
    {
      "id": "E3",
      "kind": "request",
      "file": "engine/modules/mcpp_core.cppm",
      "method": "textDocument/prepareRename",
      "at": [
        5,
        6
      ],
      "expect": null
    },
    {
      "id": "E4",
      "kind": "request",
      "file": "engine/modules/mcpp_core.cppm",
      "method": "textDocument/rename",
      "at": [
        5,
        6
      ],
      "params": {
        "newName": "flag"
      },
      "expect-error": -32803
    },
    {
      "id": "E5",
      "kind": "request",
      "file": "build.mcpp",
      "method": "textDocument/rename",
      "at": [
        6,
        11
      ],
      "params": {
        "newName": "flag"
      },
      "expect-error": -32803
    },
    {
      "id": "W1",
      "kind": "workspace-unchanged"
    }
  ]
}
