{
  "name": "cmake-msvc-std",
  "description": "CMake with import std built by cl.exe (P7): CMake's std.ixx units are replaced by the MSVC STL manifest's, and the engine runs without a developer environment.",
  "prepare-environment": "msvc",
  "prepare": [
    [
      "cmake",
      "-S",
      ".",
      "-B",
      "build",
      "-G",
      "Ninja",
      "-DCMAKE_CXX_COMPILER=cl",
      "-DCMAKE_EXPERIMENTAL_CXX_IMPORT_STD={env:CMAKE_IMPORT_STD_UUID|0e5b6991-d74f-4b3d-a41c-cf096e0b2508}",
      "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
    ],
    [
      "cmake",
      "--build",
      "build"
    ]
  ],
  "checks": [
    {
      "id": "S1",
      "kind": "status",
      "source": "cmake",
      "profile-kind": "build-toolchain",
      "profile-compiler": "msvc",
      "state": "ready"
    },
    {
      "id": "C1",
      "kind": "diagnostics-empty",
      "file": "src/main.cpp"
    },
    {
      "id": "C1-interface",
      "kind": "diagnostics-empty",
      "file": "src/greet.ixx"
    },
    {
      "id": "C2",
      "kind": "definition",
      "file": "src/main.cpp",
      "at": [
        4,
        32
      ],
      "expect": "src/greet.ixx"
    },
    {
      "id": "C3",
      "kind": "hover-contains",
      "file": "src/main.cpp",
      "at": [
        4,
        32
      ],
      "expect": "message"
    },
    {
      "id": "C3-std",
      "kind": "hover-contains",
      "file": "src/main.cpp",
      "at": [
        4,
        11
      ],
      "expect": "println"
    },
    {
      "id": "C4-std",
      "kind": "definition-any",
      "file": "src/main.cpp",
      "at": [
        4,
        11
      ]
    },
    {
      "id": "C5",
      "kind": "definition",
      "file": "src/main.cpp",
      "at": [
        0,
        8
      ],
      "expect": "src/greet.ixx"
    },
    {
      "id": "C6-std",
      "kind": "completion-contains",
      "file": "src/main.cpp",
      "insert": [
        5,
        "    std::string_v"
      ],
      "at": [
        5,
        17
      ],
      "expect": "string_view"
    },
    {
      "id": "W1",
      "kind": "workspace-unchanged"
    }
  ]
}
