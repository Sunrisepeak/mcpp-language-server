{
  "name": "mcpp-target-fallback-mismatch",
  "description": "An unavailable producer falls back to a different-architecture root CDB; requested-target validation rejects it and preserves the inferred model instead of adopting the wrong architecture.",
  "prepare": [
    [
      "{runner-dir}/mcppls-mock-mcpp{exe}",
      "--write-target-cdb",
      "i686-unknown-linux-gnu"
    ]
  ],
  "server-arguments": [
    "--mcpp",
    "{runner-dir}/mcppls-mock-mcpp{exe}",
    "--mcpp-target",
    "x86_64-unknown-linux-gnu"
  ],
  "checks": [
    {
      "id": "FALLBACK-MISMATCH",
      "kind": "status",
      "source": "inferred",
      "state": "degraded",
      "issue-code": "model-stale",
      "issue-message": "requested target",
      "target-requested": "x86_64-unknown-linux-gnu",
      "target-pending": true,
      "timeout": 60
    },
    {
      "id": "NO-EMIT",
      "kind": "producer-call-log",
      "file": "mcpp-calls.jsonl",
      "command": "emit",
      "count": 0,
      "settle": 0
    }
  ]
}
