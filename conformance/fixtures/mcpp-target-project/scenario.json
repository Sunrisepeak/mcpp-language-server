{
  "name": "mcpp-target-project",
  "description": "Project mode delegates target selection to mcpp despite a conflicting root CDB.",
  "prepare": [
    [
      "{runner-dir}/mcppls-mock-mcpp{exe}",
      "--write-target-cdb",
      "i686-unknown-linux-gnu"
    ]
  ],
  "server-arguments": [
    "--mcpp",
    "{runner-dir}/mcppls-mock-mcpp{exe}",
    "--mcpp-target",
    "project"
  ],
  "checks": [
    {
      "id": "S1-project",
      "kind": "status",
      "source": "mcpp",
      "state": "ready",
      "profile-target": "x86_64-unknown-linux-gnu",
      "target-mode": "project",
      "target-requested": "",
      "target-source": "project",
      "target-pending": false,
      "timeout": 60
    },
    {
      "id": "A1-no-target",
      "kind": "producer-call-log",
      "file": "mcpp-calls.jsonl",
      "command": "emit",
      "arguments-absent": [
        "--target"
      ],
      "count": 1
    },
    {
      "id": "A1-no-target-protocol",
      "kind": "producer-call-log",
      "file": "mcpp-calls.jsonl",
      "command": "--protocol-version",
      "count": 1
    },
    {
      "id": "W1-ignored-cdb",
      "kind": "write-file",
      "file": "compile_commands.json",
      "content": "[{\"directory\": \"{workspace}\", \"file\": \"src/main.cpp\", \"arguments\": [\"clang++\", \"--target=aarch64-unknown-linux-gnu\", \"-std=c++23\", \"-c\", \"src/main.cpp\"]}]",
      "expect-reload": false,
      "timeout": 60,
      "settle": 3
    },
    {
      "id": "A2-no-extra-emit",
      "kind": "producer-call-log",
      "file": "mcpp-calls.jsonl",
      "command": "emit",
      "arguments-absent": [
        "--target"
      ],
      "count": 1
    },
    {
      "id": "A2-no-extra-emit-protocol",
      "kind": "producer-call-log",
      "file": "mcpp-calls.jsonl",
      "command": "--protocol-version",
      "count": 1
    }
  ]
}
