{
  "name": "mcpp-all-cppm",
  "description": "Every module unit in .cppm: a primary interface that re-exports two partitions and a second module, implementations written inside the interfaces, described by mcpp's own `emit build-database`, completed to level 3 by the S1 library: navigation into partitions and through re-exports, completion through a re-exported module, edits propagated to importers, and nothing written into the project.",
  "checks": [
    {
      "id": "S1",
      "kind": "status",
      "source": "mcpp",
      "profile-kind": "build-toolchain",
      "level": 3,
      "state": "ready"
    },
    {
      "id": "C1",
      "kind": "diagnostics-empty",
      "file": "src/main.cpp"
    },
    {
      "id": "C1-partition",
      "kind": "diagnostics-empty",
      "file": "src/calc/geometry.cppm"
    },
    {
      "id": "C2-partition-type",
      "kind": "definition",
      "file": "src/main.cpp",
      "at": [
        4,
        17
      ],
      "expect": "src/calc/types.cppm"
    },
    {
      "id": "C2-partition-function",
      "kind": "definition",
      "file": "src/main.cpp",
      "at": [
        5,
        33
      ],
      "expect": "src/calc/geometry.cppm"
    },
    {
      "id": "C2-reexported-module",
      "kind": "definition",
      "file": "src/main.cpp",
      "at": [
        5,
        50
      ],
      "expect": "src/text/text.cppm"
    },
    {
      "id": "C3",
      "kind": "hover-contains",
      "file": "src/main.cpp",
      "at": [
        5,
        33
      ],
      "expect": "length"
    },
    {
      "id": "C3-partition",
      "kind": "hover-contains",
      "file": "src/calc/geometry.cppm",
      "at": [
        6,
        21
      ],
      "expect": "vec2"
    },
    {
      "id": "C4",
      "kind": "definition-any",
      "file": "src/main.cpp",
      "at": [
        5,
        11
      ]
    },
    {
      "id": "C5",
      "kind": "definition",
      "file": "src/main.cpp",
      "at": [
        1,
        8
      ],
      "expect": "src/calc/calc.cppm"
    },
    {
      "id": "C5-partition",
      "kind": "definition",
      "file": "src/calc/calc.cppm",
      "at": [
        3,
        16
      ],
      "expect": "src/calc/geometry.cppm"
    },
    {
      "id": "C5-reexported-module",
      "kind": "definition",
      "file": "src/calc/calc.cppm",
      "at": [
        4,
        16
      ],
      "expect": "src/text/text.cppm"
    },
    {
      "id": "C6",
      "kind": "completion-contains",
      "file": "src/main.cpp",
      "insert": [
        6,
        "    calc::"
      ],
      "at": [
        6,
        10
      ],
      "expect": "format_pair"
    },
    {
      "id": "C7",
      "kind": "completion-contains",
      "file": "src/main.cpp",
      "at": [
        6,
        10
      ],
      "expect": "format_triple",
      "edit": {
        "file": "src/text/text.cppm",
        "replace": "export namespace calc {",
        "with": "export namespace calc {\nstd::string format_triple(double x, double y, double z) { return std::format(\"{} {} {}\", x, y, z); }"
      }
    },
    {
      "id": "C9",
      "kind": "references-span",
      "file": "src/main.cpp",
      "at": [
        5,
        33
      ],
      "expect": [
        "src/main.cpp",
        "src/calc/geometry.cppm"
      ]
    },
    {
      "id": "C10-test",
      "kind": "definition",
      "file": "tests/calc_test.cpp",
      "at": [
        4,
        18
      ],
      "expect": "src/calc/geometry.cppm"
    },
    {
      "id": "Q1-symbol-partition",
      "kind": "mcp",
      "tool": "cxx_symbol",
      "arguments": {
        "name": "calc::length"
      },
      "expect": [
        {
          "path": "/symbols/0/module",
          "equals": "calc:geometry"
        },
        {
          "path": "/symbols/0/definition/file",
          "equals": "src/calc/geometry.cppm"
        }
      ]
    },
    {
      "id": "Q1-kind",
      "kind": "mcp",
      "tool": "cxx_symbol",
      "arguments": {
        "name": "calc::vec2",
        "kind": "struct"
      },
      "expect": [
        {
          "path": "/symbols/0/module",
          "equals": "calc:types"
        },
        {
          "path": "/symbols/0/kind",
          "equals": "struct"
        }
      ]
    },
    {
      "id": "Q2-references-reexported",
      "kind": "mcp",
      "tool": "cxx_references",
      "arguments": {
        "name": "calc::format_pair"
      },
      "expect": [
        {
          "path": "/groups/*/file",
          "equals": "src/main.cpp"
        },
        {
          "path": "/groups/*/file",
          "equals": "src/text/text.cppm"
        },
        {
          "path": "/scope/complete",
          "equals": true
        }
      ]
    },
    {
      "id": "Q2-callers",
      "kind": "mcp",
      "tool": "cxx_references",
      "arguments": {
        "name": "calc::length",
        "direction": "callers"
      },
      "expect": [
        {
          "path": "/calls/*/symbol/name",
          "equals": "main"
        },
        {
          "path": "/calls/*/sites/*/file",
          "equals": "tests/calc_test.cpp"
        }
      ]
    },
    {
      "id": "Q4-module-reexports",
      "kind": "mcp",
      "tool": "cxx_module",
      "arguments": {
        "name": "calc"
      },
      "expect": [
        {
          "path": "/exportedPartitions",
          "contains": "calc:geometry"
        },
        {
          "path": "/exportedPartitions",
          "contains": "calc:types"
        },
        {
          "path": "/imports",
          "contains": "calc.text"
        },
        {
          "path": "/interface/declarations/*/qualifiedName",
          "equals": "calc::length"
        },
        {
          "path": "/interface/declarations",
          "contains": {
            "qualifiedName": "calc::vec2",
            "kind": "struct",
            "unit": "calc:types"
          }
        },
        {
          "path": "/interface/reexports",
          "contains": "calc.text"
        }
      ]
    },
    {
      "id": "Q4-module-importers",
      "kind": "mcp",
      "tool": "cxx_module",
      "arguments": {
        "name": "calc.text"
      },
      "expect": [
        {
          "path": "/importedBy",
          "contains": "calc"
        }
      ]
    },
    {
      "id": "Q4-graph",
      "kind": "mcp",
      "tool": "cxx_module",
      "arguments": {
        "graph": true
      },
      "expect": [
        {
          "path": "/imports",
          "contains": {
            "from": "calc",
            "to": "calc.text"
          }
        },
        {
          "path": "/modules/*/name",
          "equals": "calc:geometry"
        }
      ]
    },
    {
      "id": "Q5-build-context",
      "kind": "mcp",
      "tool": "cxx_build_context",
      "arguments": {
        "file": "src/calc/types.cppm"
      },
      "expect": [
        {
          "path": "/module",
          "equals": "calc:types"
        },
        {
          "path": "/sets/0/role",
          "equals": "module-partition-interface"
        }
      ]
    },
    {
      "id": "Q8-cli-references",
      "kind": "cli",
      "args": [
        "query",
        "refs",
        "calc::length"
      ],
      "expect": [
        {
          "path": "/groups/*/file",
          "equals": "tests/calc_test.cpp"
        },
        {
          "path": "/symbol/module",
          "equals": "calc:geometry"
        }
      ]
    },
    {
      "id": "W1",
      "kind": "workspace-unchanged"
    }
  ]
}
