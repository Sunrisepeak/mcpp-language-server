{
  "name": "cmake-clang",
  "description": "A CMake project with C++20 modules built by Clang and Ninja: the model comes from the build directory's compile database, whose @modmap response files are expanded and whose BMI arguments are removed.",
  "prepare": [
    ["cmake", "-S", ".", "-B", "build", "-G", "Ninja", "-DCMAKE_CXX_COMPILER={env:CONFORMANCE_CLANGXX|clang++}", "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"],
    ["cmake", "--build", "build"]
  ],
  "checks": [
    { "id": "S1", "kind": "status", "source": "cmake", "profile-kind": "build-toolchain", "state": "ready" },
    { "id": "C1", "kind": "diagnostics-empty", "file": "src/main.cpp" },
    { "id": "C2", "kind": "definition", "file": "src/main.cpp", "at": [3, 21], "expect": "src/shapes.cppm" },
    { "id": "C2-partition-symbol", "kind": "definition", "file": "src/main.cpp", "at": [3, 58], "expect": "src/circle.cppm" },
    { "id": "C3", "kind": "hover-contains", "file": "src/main.cpp", "at": [3, 21], "expect": "square" },
    { "id": "C5", "kind": "definition", "file": "src/main.cpp", "at": [0, 9], "expect": "src/shapes.cppm" },
    { "id": "C5-partition", "kind": "definition", "file": "src/shapes.cppm", "at": [1, 16], "expect": "src/circle.cppm" },
    { "id": "C9", "kind": "references-span", "file": "src/main.cpp", "at": [3, 21], "expect": ["src/main.cpp", "src/shapes.cppm"] }
  ]
}
