{
  "name": "xmake-no-standard",
  "description": "0.0.8 part 2 X-3, X-7 (E4): an xmake project that never says set_languages, built by GCC 16 and importing std. xmake's commands carry no -std, and GCC 16 reads that as gnu++20; clang reads it as gnu++17, which cannot build libstdc++'s std module (20 errors). The engine command is given the standard the build compiler would use (-std=gnu++20) and std is prepared. Passes once X-3 (normalize/gnu.cpp) is in.",
  "checks": [
    {
      "id": "S1",
      "kind": "status",
      "source": "xmake",
      "profile-kind": "build-toolchain",
      "tier": 3,
      "state": "ready",
      "timeout": 180
    },
    {
      "id": "E1-the-build-compilers-default",
      "kind": "engine-command",
      "file": "src/main.cpp",
      "contains": ["-std=gnu++20"],
      "timeout": 30
    },
    {
      "id": "C6-std-is-prepared",
      "kind": "hover-contains",
      "file": "src/main.cpp",
      "at": [4, 10],
      "expect": "println",
      "timeout": 120
    },
    {
      "id": "C1",
      "kind": "diagnostics-empty",
      "file": "src/main.cpp"
    },
    {
      "id": "R1-nothing-is-stuck",
      "kind": "report",
      "timeout": 20,
      "expect": [
        { "path": "/roots/0/project/issues/*/code", "equals": "preparation-stalled", "max-matches": 0 },
        { "path": "/roots/0/project/issues/*/code", "equals": "module-scan-failed", "max-matches": 0 }
      ]
    },
    {
      "id": "W1",
      "kind": "workspace-unchanged"
    }
  ]
}
