{
  "name": "compdb-clangxx-msvc-std",
  "description": "clang++ for the MSVC ABI with import std (P5), built by the fixture itself because CMake's import std supports only libc++ and libstdc++ with clang.",
  "prepare-environment": "msvc",
  "prepare": [
    [
      "{conformance}",
      "prepare",
      "compdb-clangxx-msvc-std"
    ]
  ],
  "checks": [
    {
      "id": "S1",
      "kind": "status",
      "source": "compile-commands",
      "profile-kind": "build-toolchain",
      "profile-compiler": "clang",
      "state": "ready"
    },
    {
      "id": "C1",
      "kind": "diagnostics-empty",
      "file": "src/main.cpp"
    },
    {
      "id": "C1-interface",
      "kind": "diagnostics-empty",
      "file": "src/greet.cppm"
    },
    {
      "id": "C2",
      "kind": "definition",
      "file": "src/main.cpp",
      "at": [
        4,
        32
      ],
      "expect": "src/greet.cppm"
    },
    {
      "id": "C3",
      "kind": "hover-contains",
      "file": "src/main.cpp",
      "at": [
        4,
        32
      ],
      "expect": "message"
    },
    {
      "id": "C3-std",
      "kind": "hover-contains",
      "file": "src/main.cpp",
      "at": [
        4,
        11
      ],
      "expect": "println"
    },
    {
      "id": "C4-std",
      "kind": "definition-any",
      "file": "src/main.cpp",
      "at": [
        4,
        11
      ]
    },
    {
      "id": "C5",
      "kind": "definition",
      "file": "src/main.cpp",
      "at": [
        0,
        8
      ],
      "expect": "src/greet.cppm"
    },
    {
      "id": "C6-std",
      "kind": "completion-contains",
      "file": "src/main.cpp",
      "insert": [
        5,
        "    std::string_v"
      ],
      "at": [
        5,
        17
      ],
      "expect": "string_view"
    },
    {
      "id": "W1",
      "kind": "workspace-unchanged"
    }
  ]
}
