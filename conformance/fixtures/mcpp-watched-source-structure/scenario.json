      "count": 2,
      "settle": 3
    },
    {
      "id": "NEXT-REAL-LEXICAL-STRUCTURE",
      "kind": "write-file",
      "file": "src/main.cpp",
      "notify": true,
      "timeout": 30,
      "content": "import target.platform;\n#if 0\nimport disabled.alpha;\nimport disabled.beta;\n#endif\n\nint target_user() { return architecture_bits() + 2; }\n",
      "expect-reload": true
    },
    {
      "id": "NEXT-STRUCTURE-READY",
      "kind": "status",
