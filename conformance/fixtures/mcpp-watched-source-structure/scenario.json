{
  "name": "mcpp-watched-source-structure",
  "description": "G-5: a lexical import inside #if 0 is correctly absent from the producer dependency graph. Describe its first structure change once, then do not re-emit for body-only saves or repeated identical watch events after the unchanged valid model answers. A second structure change, manifest input, target selection and actual producer replacement must still reload. This isolates a repeat-scheduling defect and does not assign the original U15 frequency failure a cause. Preprocessor input changes still emit; failed answers do not acknowledge their structure, and a structure changed during a delayed producer run requires its own subsequent run. A second real source starts with an active conditional import whose dependencies equal the lexical names: disabling it must emit both before and after acknowledgement, and the producer recordings update that unit requires accordingly.",
  "prepare": [
    [
      "{runner-dir}/mcppls-mock-mcpp{exe}",
      "--copy-self",
      "producer/mcpp.exe"
    ],
    [
      "{runner-dir}/mcppls-mock-mcpp{exe}",
      "--copy-self",
      "replacement/mcpp.exe"
    ]
  ],
  "server-arguments": [
    "--mcpp",
    "{workspace}/producer/mcpp.exe"
  ],
  "initialization-options": {
    "buildDiscovery.mcppTarget": "project"
  },
  "checks": [
    {
      "id": "INITIAL",
      "kind": "status",
      "source": "mcpp",
      "state": "ready",
      "timeout": 60,
      "profile-target": "x86_64-unknown-linux-gnu",
      "producer-version": "2026.10.22.1"
    },
    {
      "id": "INITIAL-EMIT",
      "kind": "producer-call-log",
      "file": "mcpp-calls.jsonl",
      "command": "emit",
      "count": 1,
      "settle": 3
    },
    {
      "id": "CONDITIONAL-STRUCTURE-CHANGE",
      "kind": "write-file",
      "file": "src/main.cpp",
      "notify": true,
      "timeout": 30,
      "content": "import target.platform;\n#if 0\nimport disabled.alpha;\n#endif\n\nint target_user() { return architecture_bits() + 0; }\n",
      "expect-reload": true
    },
    {
      "id": "CONDITIONAL-MODEL-READY",
      "kind": "status",
      "source": "mcpp",
      "state": "ready",
      "timeout": 60
    },
    {
      "id": "STRUCTURE-DESCRIBED-ONCE",
      "kind": "producer-call-log",
      "file": "mcpp-calls.jsonl",
      "command": "emit",
      "count": 2,
      "settle": 3
    },
    {
      "id": "BODY-ONLY-ONE",
      "kind": "write-file",
      "file": "src/main.cpp",
      "notify": true,
      "timeout": 30,
      "content": "import target.platform;\n#if 0\nimport disabled.alpha;\n#endif\n\nint target_user() { return architecture_bits() + 1; }\n",
      "expect-reload": false,
      "settle": 5
    },
    {
      "id": "BODY-ONLY-ONE-NO-EMIT",
      "kind": "producer-call-log",
      "file": "mcpp-calls.jsonl",
      "command": "emit",
      "count": 2,
      "settle": 3
    },
    {
      "id": "BODY-ONLY-TWO",
      "kind": "write-file",
      "file": "src/main.cpp",
      "notify": true,
      "timeout": 30,
      "content": "import target.platform;\n#if 0\nimport disabled.alpha;\n#endif\n\nint target_user() { return architecture_bits() + 2; }\n",
      "expect-reload": false,
      "settle": 5
    },
    {
      "id": "BODY-ONLY-TWO-NO-EMIT",
      "kind": "producer-call-log",
      "file": "mcpp-calls.jsonl",
      "command": "emit",
      "count": 2,
      "settle": 3
    },
    {
      "id": "SAME-BYTES-AGAIN",
      "kind": "write-file",
      "file": "src/main.cpp",
      "notify": true,
      "timeout": 30,
      "content": "import target.platform;\n#if 0\nimport disabled.alpha;\n#endif\n\nint target_user() { return architecture_bits() + 2; }\n",
      "expect-reload": false,
      "settle": 5
    },
    {
      "id": "SAME-BYTES-AGAIN-NO-EMIT",
      "kind": "producer-call-log",
      "file": "mcpp-calls.jsonl",
